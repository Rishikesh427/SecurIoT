{$SITE_ADDRESS:http://localhost} {
    encode zstd gzip
    redir /api /api/ 308
    handle_path /api/* {
        reverse_proxy api:8000
    }
    @backend path /healthz /readyz /storage /auth/* /ingest /sync /ack /commands/* /devices /devices/* /events /actions /policy /audit /audit/*
    handle @backend {
        reverse_proxy api:8000
    }
    handle {
        header Cache-Control "no-cache"
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
