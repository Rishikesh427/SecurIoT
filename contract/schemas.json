{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securiot.invalid/contract/schemas.json",
  "title": "SecurIoT v3.2 shared contract",
  "$ref": "#/$defs/Ingest",
  "$defs": {
    "StorageStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "demo_storage",
        "persistent",
        "badge",
        "reason",
        "recovery"
      ],
      "properties": {
        "mode": {
          "enum": [
            "postgres",
            "memory"
          ]
        },
        "demo_storage": {
          "type": "boolean"
        },
        "persistent": {
          "type": "boolean"
        },
        "badge": {
          "enum": [
            "Tiger Data",
            "Demo storage"
          ]
        },
        "reason": {
          "enum": [
            null,
            "configured",
            "database_unavailable"
          ]
        },
        "recovery": {
          "enum": [
            null,
            "restart"
          ]
        }
      }
    },
    "PolicyInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learning_mode": {
          "type": "boolean",
          "default": true
        },
        "protected_macs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1000,
          "default": [],
          "items": {
            "$ref": "#/$defs/Mac"
          }
        },
        "ladder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notify": {
              "type": "boolean",
              "default": true
            },
            "block_wan": {
              "type": "boolean",
              "default": true
            },
            "quarantine": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "LoginRequest": {
      "type": "object",
      "required": [
        "username",
        "password"
      ],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "TokenResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_token",
        "token_type",
        "expires_in"
      ],
      "properties": {
        "access_token": {
          "type": "string"
        },
        "token_type": {
          "const": "bearer"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      }
    },
    "UserResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "username",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "type": "string"
        },
        "role": {
          "enum": [
            "judge",
            "admin"
          ]
        }
      }
    },
    "Mac": {
      "type": "string",
      "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$"
    },
    "ActionName": {
      "enum": [
        "block_wan",
        "quarantine",
        "restore",
        "restore_all"
      ]
    },
    "Device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mac",
        "ip",
        "name",
        "label",
        "type",
        "vendor",
        "ports",
        "bytes_in",
        "bytes_out",
        "dests",
        "last_seen",
        "simulated",
        "has_feed",
        "eol",
        "default_creds",
        "cloud_only",
        "anomaly",
        "risk",
        "band",
        "confidence",
        "reasons",
        "status"
      ],
      "properties": {
        "mac": {
          "$ref": "#/$defs/Mac"
        },
        "ip": {
          "type": "string",
          "format": "ipv4"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "kev": {
          "enum": [
            "confirmed",
            "possible",
            "none",
            "unknown"
          ]
        },
        "ports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "bytes_in": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_out": {
          "type": "integer",
          "minimum": 0
        },
        "dests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "simulated": {
          "type": "boolean"
        },
        "has_feed": {
          "type": "boolean"
        },
        "eol": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "default_creds": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cloud_only": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "anomaly": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "risk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "normal",
            "wan_blocked",
            "quarantined",
            "offline"
          ]
        }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mac",
        "ts",
        "kind",
        "evidence",
        "actions_taken",
        "would_have",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "mac": {
          "$ref": "#/$defs/Mac"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "scan_arp",
            "scan_targets",
            "decoy_touch",
            "new_domain",
            "new_device",
            "volume"
          ]
        },
        "evidence": {
          "type": "object"
        },
        "actions_taken": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionName"
          }
        },
        "would_have": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionName"
          }
        },
        "source": {
          "enum": [
            "agent",
            "simulator"
          ]
        }
      }
    },
    "Explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plain_language",
        "recommended_next_step"
      ],
      "properties": {
        "plain_language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "recommended_next_step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "EventView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mac",
        "ts",
        "kind",
        "evidence",
        "actions_taken",
        "would_have",
        "source",
        "explanation",
        "explanation_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "mac": {
          "$ref": "#/$defs/Mac"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "scan_arp",
            "scan_targets",
            "decoy_touch",
            "new_domain",
            "new_device",
            "volume"
          ]
        },
        "evidence": {
          "type": "object"
        },
        "actions_taken": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionName"
          }
        },
        "would_have": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionName"
          }
        },
        "source": {
          "enum": [
            "agent",
            "simulator"
          ]
        },
        "explanation": {
          "$ref": "#/$defs/Explanation"
        },
        "explanation_status": {
          "enum": [
            "pending",
            "ready",
            "template"
          ]
        }
      }
    },
    "Ingest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devices",
        "events"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Device"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        }
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionName"
        },
        "mac": {
          "$ref": "#/$defs/Mac"
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "restore_all"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "mac"
          ]
        }
      },
      "else": {
        "required": [
          "mac"
        ]
      }
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "$ref": "#/$defs/ActionName"
        },
        "mac": {
          "$ref": "#/$defs/Mac"
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "restore_all"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "mac"
          ]
        }
      },
      "else": {
        "required": [
          "mac"
        ]
      }
    },
    "Ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ts"
      ],
      "properties": {
        "status": {
          "enum": [
            "applied",
            "failed"
          ]
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_mode",
        "protected_macs",
        "ladder"
      ],
      "properties": {
        "learning_mode": {
          "type": "boolean",
          "default": true
        },
        "protected_macs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Mac"
          }
        },
        "ladder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "notify",
            "block_wan",
            "quarantine"
          ],
          "properties": {
            "notify": {
              "type": "boolean"
            },
            "block_wan": {
              "type": "boolean"
            },
            "quarantine": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "Sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "etag",
        "policy",
        "commands"
      ],
      "properties": {
        "etag": {
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Command"
          }
        }
      }
    },
    "AuditEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ts",
        "actor",
        "action",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "mac": {
          "$ref": "#/$defs/Mac"
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "outcome": {
          "enum": [
            "requested",
            "applied",
            "failed",
            "would_have"
          ]
        }
      }
    },
    "AuditRunResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "bullets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "DeviceAi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "assessment",
        "likely_type",
        "expected_behavior",
        "top_risk",
        "next_step",
        "confidence",
        "delta",
        "delta_reason",
        "risk_adjusted"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "pending",
            "unavailable",
            "off"
          ]
        },
        "source": {
          "enum": [
            "gemini",
            "rules"
          ]
        },
        "assessment": {
          "type": "string"
        },
        "likely_type": {
          "type": "string"
        },
        "expected_behavior": {
          "type": "string"
        },
        "top_risk": {
          "type": "string"
        },
        "next_step": {
          "type": "string"
        },
        "delta_reason": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "delta": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10
        },
        "risk_adjusted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "DeviceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mac",
        "ip",
        "name",
        "label",
        "type",
        "vendor",
        "ports",
        "bytes_in",
        "bytes_out",
        "dests",
        "last_seen",
        "simulated",
        "has_feed",
        "eol",
        "default_creds",
        "cloud_only",
        "anomaly",
        "risk",
        "band",
        "confidence",
        "reasons",
        "status",
        "risk_adjusted",
        "ai"
      ],
      "properties": {
        "mac": {
          "$ref": "#/$defs/Mac"
        },
        "ip": {
          "type": "string",
          "format": "ipv4"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "kev": {
          "enum": [
            "confirmed",
            "possible",
            "none",
            "unknown"
          ]
        },
        "ports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "bytes_in": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_out": {
          "type": "integer",
          "minimum": 0
        },
        "dests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "simulated": {
          "type": "boolean"
        },
        "has_feed": {
          "type": "boolean"
        },
        "eol": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "default_creds": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cloud_only": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "anomaly": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "risk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "normal",
            "wan_blocked",
            "quarantined",
            "offline"
          ]
        },
        "risk_adjusted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ai": {
          "$ref": "#/$defs/DeviceAi"
        },
        "snapshot_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "AdvisorTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "text"
      ],
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "AdvisorChat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mac",
        "question"
      ],
      "properties": {
        "mac": {
          "$ref": "#/$defs/Mac"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "history": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/AdvisorTurn"
          }
        }
      }
    },
    "AdvisorAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "answer"
      ],
      "properties": {
        "source": {
          "enum": [
            "gemini",
            "rules"
          ]
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AdvisorTriage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "order"
      ],
      "properties": {
        "source": {
          "enum": [
            "gemini",
            "rules"
          ]
        },
        "order": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mac",
              "why"
            ],
            "properties": {
              "mac": {
                "$ref": "#/$defs/Mac"
              },
              "why": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
