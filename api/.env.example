APP_ENV=development
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE?sslmode=require
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash
AGENT_API_KEY=GENERATE_A_RANDOM_VALUE
JWT_SECRET=GENERATE_A_LONG_RANDOM_VALUE
CORS_ORIGINS=http://localhost:5173

# Reserved for the later agent feed integration.
FEED_TOKEN=GENERATE_A_SEPARATE_RANDOM_VALUE
ROOT_PATH=
JWT_ISSUER=securiot
JWT_AUDIENCE=securiot-dashboard
JWT_EXPIRE_MINUTES=60
# auto: switch to demo memory on connection loss, staying there until restart.
# postgres: fail closed on outage. memory: explicit disposable demo mode.
STORAGE_MODE=auto
# Used by python -m api.manage init-db. Re-running does not reset the password.
JUDGE_USERNAME=judge
JUDGE_PASSWORD=GENERATE_A_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
