# Production: same-origin Caddy proxy. `npm run dev` proxies /api to http://localhost:8000.
VITE_API_BASE_URL=/api
VITE_API_URL=/api
# Mock data is the default for `npm run dev`; builds use the real API.
# Set VITE_USE_MOCK=false (or VITE_MOCK_MODE=false) to use the API in dev, or true to ship a mock-only build.
# Docker passes VITE_MOCK_MODE from the root .env.
# VITE_USE_MOCK=false
# Agent-only camera feed (local API on the router laptop). Leave unset in the cloud.
# VITE_FEED_URL=http://10.42.0.1:8787
